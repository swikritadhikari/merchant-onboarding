NODE_ENV=development
PORT=3000

CORS_ORIGINS=
TRUST_PROXY=false
SWAGGER_ENABLED=
HTTP_REQUEST_TIMEOUT_MS=30000
SHUTDOWN_TIMEOUT_MS=15000
RATE_LIMIT_PER_MINUTE=120

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=merchant_app
DB_PASSWORD=
DB_NAME=merchant_onboarding
DB_STATEMENT_TIMEOUT_MS=15000
DB_LOCK_TIMEOUT_MS=5000
DB_CONNECT_TIMEOUT_MS=5000
DB_TEST_NAME=merchant_onboarding_test

REDIS_HOST=localhost
CACHE_KEY_PREFIX=cache
AUTH_PRINCIPAL_CACHE_TTL_SECONDS=60
USERS_LIST_CACHE_TTL_SECONDS=300
REDIS_PORT=6379

JWT_SECRET=
JWT_EXPIRES_IN_SECONDS=900
JWT_ISSUER=merchant-onboarding-api
JWT_AUDIENCE=merchant-onboarding-clients
REFRESH_TOKEN_EXPIRES_IN_SECONDS=604800
LOGIN_RATE_LIMIT_PER_MINUTE=10
PASSWORD_HASH_ROUNDS=12

RISK_WORKER_ENABLED=true
RISK_JOB_ATTEMPTS=5
RISK_JOB_BACKOFF_MS=2000
RISK_PROVIDER_LATENCY_MS=300
RISK_PROVIDER_TIMEOUT_MS=5000
RISK_PROVIDER_FAILURE_RATE=0.2

SEED_USER_PASSWORD=
